      "gnn_vs_pg_disagreement_ratio": 2.3379318062333017,
      "pgexplainer_edge_mask_max_mean": 0.12497605066746473,
      "pgexplainer_edge_mask_max_std": 0.042562356469195005
    },
    "content_feature_importance": {
      "method": "Captum Integrated Gradients on edge_attr, batched across sampled flows, P(attack) as target output.",
      "top_10_features": [
